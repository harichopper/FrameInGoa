# ─────────────────────────────────────────────────────────────
#  FrameInGoa — HH Goa 2026  |  Environment Variables
#  Copy this to .env and fill in the real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
# The public URL where the app is deployed (no trailing slash)
APP_URL="http://localhost:3000"

# ── Gemini AI (Optional — for title generation) ────────────────
GEMINI_API_KEY="your_gemini_api_key_here"

# ── X (Twitter) OAuth 2.0 ─────────────────────────────────────
# Create an app at: https://developer.twitter.com/en/portal/projects-and-apps
# Required OAuth 2.0 scopes: users.read  tweet.read
# Set Redirect URI to: ${APP_URL}/api/auth/twitter/callback

TWITTER_CLIENT_ID="your_twitter_oauth2_client_id"
TWITTER_CLIENT_SECRET="your_twitter_oauth2_client_secret"

# Must exactly match one of the Callback URIs registered in the Twitter App dashboard
TWITTER_REDIRECT_URI="http://localhost:3000/api/auth/twitter/callback"
# For production: TWITTER_REDIRECT_URI="https://your-domain.vercel.app/api/auth/twitter/callback"

# ── Session Security ───────────────────────────────────────────
# Random 256-bit hex string. Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"

# ── Supabase (PostgreSQL backend) ─────────────────────────────
# Create a project at: https://supabase.com
# Run supabase/schema.sql in the SQL Editor to create tables.
# Use the *service_role* key in backend API routes (never expose in frontend).

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# For the frontend (public key — safe to expose):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
